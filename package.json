{
  "private": true,
  "name": "@xgenia/repo",
  "description": "Low-code for when experience matter",
  "author": "XGENIA <contact@xgenia.io>",
  "homepage": "https://xgenia.ai",
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "MainModules/*",
    "private/*"
  ],
  "scripts": {
    "graph": "npx nx graph",
    "ci:prepare:editor": "ts-node ./scripts/ci-editor-prepare.ts",
    "ci:build:viewer": "lerna exec --scope @xgenia/xgenia-viewer-react -- npm run build",
    "ci:builled:editor": "lerna exec --scope xgenia-editor -- npm run ci:build",
    "clean:modules": "rimraf '**/node_modules'",
    "build:editor": "ts-node ./scripts/build-editor.ts",
    "build:editor:_viewer": "ts-node ./scripts/xgenia-editor/build-viewer.ts",
    "build:editor:_editor": "ts-node ./scripts/xgenia-editor/build-editor.ts",
    "build:editor:pack": "ts-node ./scripts/build-pack.ts",
    "build:cloud-runtime": "lerna run build --scope @xgenia/cloud-runtime --stream && lerna run build:pack --scope @xgenia/cloud-runtime --stream",
    "start:storybook": "lerna exec --scope @xgenia/xgenia-core-ui -- npm run start",
    "start:viewer": "lerna run start --scope @xgenia/xgenia-viewer-react --stream",
    "start:editor": "lerna run build:main:dev --scope xgenia-editor --stream && lerna run start --scope xgenia-editor --stream",
    "dev": "npx ts-node --project tsconfig.json ./scripts/dev-launcher.ts",
    "dev:simple": "npx ts-node --project tsconfig.json ./scripts/start.ts",
    "dev:ai": "concurrently -n editor,ai-plugin -c blue,green \"npm run dev\" \"cd private/xgenia-ai-app && npm run dev\"",
    "start": "npx ts-node --project tsconfig.json ./scripts/start.ts -- --build-viewer",
    "test:editor": "npx ts-node ./scripts/test-editor.ts",
    "test:platform": "lerna exec --scope @xgenia/platform-node -- npm test",
    "export-cert": "./scripts/export-macos-certificate.sh",
    "mock:rgs": "node ./scripts/mock-rgs-server.mjs --port 5050",
    "start:ai": "cd private/xgenia-ai-service && npm install && npm run dev"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.26.3",
    "@ianvs/prettier-plugin-sort-imports": "^3.7.1",
    "@types/electron": "^1.4.38",
    "@types/keyv": "3.1.4",
    "@types/node": "^18.19.100",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.49.0",
    "@vitejs/plugin-react": "^4.4.1",
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.33.0",
    "eslint-plugin-react": "^7.32.2",
    "fs-extra": "^10.0.0",
    "https-browserify": "^1.0.0",
    "lerna": "^8.2.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "rimraf": "^3.0.2",
    "sass": "^1.85.0",
    "sass-loader": "^16.0.5",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vite": "^6.4.1",
    "webpack": "^5.84.1",
    "webpack-cli": "^5.1.1",
    "webpack-dev-server": "^4.15.0"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=18.0.0 <=24"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.812.0",
    "@fal-ai/client": "^1.9.4",
    "@microlink/react-json-view": "^1.26.2",
    "@storybook/react": "8.5.6",
    "copy-webpack-plugin": "12.0.2",
    "desktop-trampoline": "https://github.com/desktop/desktop-trampoline/archive/refs/tags/v0.9.8.tar.gz",
    "dugite": "^2.7.1",
    "electron-notarize": "^1.2.2",
    "html-to-image": "^1.11.13",
    "keytar": "^7.9.0",
    "lucide-react": "^0.503.0",
    "passport": "0.7.0",
    "react-hot-toast": "^2.5.2",
    "react-markdown": "^10.1.0"
  },
  "overrides": {
    "revolt-fx": {
      "pixi.js": "^8.0.0"
    }
  }
}
