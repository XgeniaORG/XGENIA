 "group": "Inputs", "name": "input2", "displayName": "Input totalWinnings", "index": 19}, {"type": "string", "plug": "input", "group": "Aliases", "name": "alias2", "displayName": "Alias 2", "default": "", "index": 20}, {"type": "*", "plug": "output", "group": "Outputs", "name": "output2", "displayName": "Output totalWinnings", "index": 21}, {"type": "*", "plug": "input", "group": "Inputs", "name": "input3", "displayName": "Input spinCount", "index": 22}, {"type": "string", "plug": "input", "group": "Aliases", "name": "alias3", "displayName": "Alias 3", "default": "", "index": 23}, {"type": "*", "plug": "output", "group": "Outputs", "name": "output3", "displayName": "Output spinCount", "index": 24}, {"type": "*", "plug": "input", "group": "Inputs", "name": "input4", "displayName": "Input hits", "index": 25}, {"type": "string", "plug": "input", "group": "Aliases", "name": "alias4", "displayName": "Alias 4", "default": "", "index": 26}, {"type": "*", "plug": "output", "group": "Outputs", "name": "output4", "displayName": "Output hits", "index": 27}, {"type": "signal", "plug": "output", "group": "Control", "name": "updated", "displayName": "Updated", "index": 28}, {"type": "signal", "plug": "output", "group": "Control", "name": "Reset Done", "displayName": "Reset Done", "index": 29}, {"type": "object", "plug": "output", "group": "Combined Output", "name": "stateObject", "displayName": "State Object", "index": 30}, {"type": "string", "plug": "output", "group": "Combined Output", "name": "objectId", "displayName": "Object ID", "index": 31}], "children": []}, {"id": "578255c0-5e22-00b7-6371-add0fe95b886", "type": "Relay", "label": "UpdateRelay", "x": 1338, "y": 152, "parameters": {"name": "UpdateRelay", "label": "UpdateRelay", "nodeLabel": "UpdateRelay"}, "ports": [], "dynamicports": [], "children": []}, {"id": "9296d951-cad7-8520-6580-649c814633e5", "type": "Variable2", "label": "ReelStripsVar", "x": 120, "y": 600, "parameters": {"name": "reelStrips", "label": "ReelStripsVar", "nodeLabel": "ReelStripsVar"}, "ports": [], "dynamicports": [], "children": []}, {"id": "524dd6b2-d510-07e7-d581-30a9d0765ba4", "type": "Set Variable", "label": "SetReelStrips", "x": 300, "y": 600, "parameters": {"name": "reelStrips", "nodeLabel": "SetReelStrips", "label": "SetReelStrips"}, "ports": [], "dynamicports": [{"type": "*", "plug": "input", "group": "General", "name": "value", "displayName": "Value", "index": 5}], "children": []}, {"id": "bdbea8ee-5c71-ed21-df4e-74c0a3fe7115", "type": "JavaScriptFunction", "label": "RP_PassLoop", "x": 1978, "y": 0, "parameters": {"functionScript": "// RP_PassLoop \u2014 scores one spin's tumbles before the round is shown. Built by scaffold({action:\"round_player\", cascade: true}).\n//\n// Pass 1 scores the spin's board. While a pass wins, its winning cells are removed and refilled\n// (@RP_PassCascade, fresh @RP_PassTRNG \u2192 @RP_PassISAAC seeds every pass) and the new board is scored\n// again, until a pass wins nothing or MAX_PASSES is reached. The round's win is the SUM of the\n// passes: Total goes where the first pass's win used to go, so the maths pays (and takes the bet)\n// once per spin, as before. Book lists every pass {grid, win, winningCells} for the round player.\n//\n// run fires three ways: the spin's board is ready (a new board), a pass was scored, a refill is ready.\nconst MAX_PASSES = 12;\nconst s = globalThis.__RP_PassLoop || (globalThis.__RP_PassLoop = {});\nif (Inputs.SpinBoard !== s._spinBoard) {            // a new spin: score its board (pass 1)\n  s._spinBoard = Inputs.SpinBoard;\n  s._grid = Inputs.SpinBoard;\n  s._passes = [];\n  s._total = 0;\n  s._phase = 'score';\n  Outputs.Grid = s._grid;\n  Outputs.Score();\n  return;\n}\nif (s._phase === 'refill') {                         // the refill is ready: score the new board\n  if (!Array.isArray(Inputs.Refilled) || Inputs.Refilled === s._grid) return;\n  s._grid = Inputs.Refilled;\n  s._phase = 'score';\n  Outputs.Grid = s._grid;\n  Outputs.Score();\n  return;\n}\nif (s._phase !== 'score') return;\nconst win = Number(Inputs.Win) || 0;                // a pass was scored\ns._total += win;\ns._passes.push({ grid: s._grid, win: win, winningCells: Array.isArray(Inputs.Cells) ? Inputs.Cells : [] });\nif (win > 0 && s._passes.length < MAX_PASSES) {\n  s._phase = 'refill';\n  Outputs.Refill();                                  // remove this pass's winning cells and refill them\n  return;\n}\ns._phase = 'settled';\nOutputs.Total = s._total;\nOutputs.Book = { passes: s._passes.slice(), total: s._total };\nOutputs.Settle();                                    // the maths settles the round once, on the total\n", "nodeLabel": "RP_PassLoop"}, "ports": [], "dynamicports": [{"name": "in-SpinBoard", "displayName": "SpinBoard", "plug": "input", "type": "*", "group": "Inputs", "index": 4}, {"name": "in-Refilled", "displayName": "Refilled", "plug": "input", "type": "*", "group": "Inputs", "index": 5}, {"name": "in-Win", "displayName": "Win", "plug": "input", "type": "*", "group": "Inputs", "index": 6}, {"name": "in-Cells", "displayName": "Cells", "plug": "input", "type": "*", "group": "Inputs", "index": 7}, {"name": "out-Score", "displayName": "Score", "plug": "output", "type": "signal", "group": "Outputs", "index": 8}, {"name": "out-Refill", "displayName": "Refill", "plug": "output", "type": "signal", "group": "Outputs", "index": 9}, {"name": "out-Settle", "displayName": "Settle", "plug": "output", "type": "signal", "group": "Outputs", "index": 10}, {"name": "out-Grid", "displayName": "Grid", "plug": "output", "type": "*", "group": "Outputs", "index": 11}, {"name": "out-Total", "displayName": "Total", "plug": "output", "type": "*", "group": "Outputs", "index": 12}, {"name": "out-Book", "displayName": "Book", "plug": "output", "type": "*", "group": "Outputs", "index": 13}], "children": []}, {"id": "911afd4e-2140-c486-136a-b3d7179d9c47", "type": "True Random Number Generator", "label": "RP_PassTRNG", "x": 2338, "y": 0, "