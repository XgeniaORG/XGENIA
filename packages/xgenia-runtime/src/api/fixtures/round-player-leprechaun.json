": "TRNG_Spin", "x": 300, "y": 120, "parameters": {"name": "TRNG_Spin", "label": "TRNG_Spin", "nodeLabel": "TRNG_Spin"}, "ports": [], "dynamicports": [], "children": []}, {"id": "77f67a5a-8872-6e57-e90b-9e4a50f597f2", "type": "ISAAC Random Number Array Generator", "label": "ISAAC_Init", "x": 540, "y": 120, "parameters": {"size": 5, "name": "ISAAC_Init", "label": "ISAAC_Init", "nodeLabel": "ISAAC_Init"}, "ports": [], "dynamicports": [], "children": []}, {"id": "629bc57d-d4c8-6987-8472-145e13263ae5", "type": "ISAAC Random Number Array Generator", "label": "ISAAC_Spin", "x": 780, "y": 120, "parameters": {"size": 25, "name": "ISAAC_Spin", "label": "ISAAC_Spin", "nodeLabel": "ISAAC_Spin"}, "ports": [], "dynamicports": [], "children": []}, {"id": "57f7a5a7-3382-ffce-b3a6-4f996b78c06e", "type": "Generate Symbol Weights", "label": "SymbolWeights", "x": 780, "y": 120, "parameters": {"numberOfSymbols": 10, "weightFormula": "exp(-x/4)", "name": "SymbolWeights", "label": "SymbolWeights", "nodeLabel": "SymbolWeights"}, "ports": [], "dynamicports": [{"type": "number", "plug": "input", "group": "Custom Weights", "name": "symbolWeight1", "displayName": "Symbol 1 Custom Weight", "default": 0.7788007830714049, "index": 6}, {"type": "number", "plug": "input", "group": "Custom Weights", "name": "symbolWeight2", "displayName": "Symbol 2 Custom Weight", "default": 0.6065306597126334, "index": 7}, {"type": "number", "plug": "input", "group": "Custom Weights", "name": "symbolWeight3", "displayName": "Symbol 3 Custom Weight", "default": 0.4723665527410147, "index": 8}, {"type": "number", "plug": "input", "group": "Custom Weights", "name": "symbolWeight4", "displayName": "Symbol 4 Custom Weight", "default": 0.36787944117144233, "index": 9}, {"type": "number", "plug": "input", "group": "Custom Weights", "name": "symbolWeight5", "displayName": "Symbol 5 Custom Weight", "default": 0.2865047968601901, "index": 10}, {"type": "number", "plug": "input", "group": "Custom Weights", "name": "symbolWei