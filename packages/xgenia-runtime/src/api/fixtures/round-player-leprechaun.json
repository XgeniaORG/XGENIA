": 31}], "children": []}, {"id": "57934163-c132-2b8b-1cc4-1cf826f91ed3", "type": "Check Wins", "label": "CheckWins", "x": 300, "y": 240, "parameters": {"customPaylines": [[[0, 0], [1, 0], [2, 0], [3, 0], [4, 0]], [[0, 1], [1, 1], [2, 1], [3, 1], [4, 1]], [[0, 2], [1, 2], [2, 2], [3, 2], [4, 2]], [[0, 3], [1, 3], [2, 3], [3, 3], [4, 3]], [[0, 4], [1, 4], [2, 4], [3, 4], [4, 4]], [[0, 0], [1, 1], [2, 2], [3, 3], [4, 4]], [[0, 4], [1, 3], [2, 2], [3, 1], [4, 0]], [[0, 0], [1, 1], [2, 0], [3, 1], [4, 0]], [[0, 4], [1, 3], [2, 4], [3, 3], [4, 4]], [[0, 1], [1, 2], [2, 3], [3, 2], [4, 1]], [[0, 3], [1, 2], [2, 1], [3, 2], [4, 3]], [[0, 1], [1, 0], [2, 0], [3, 0], [4, 1]], [[0, 3], [1, 4], [2, 4], [3, 4], [4, 3]], [[0, 2], [1, 1], [2, 0], [3, 1], [4, 2]], [[0, 2], [1, 3], [2, 4], [3, 3], [4, 2]], [[0, 0], [1, 1], [2, 1], [3, 1], [4, 0]], [[0, 4], [1, 3], [2, 3], [3, 3], [4, 4]], [[0, 1], [1, 2], [2, 1], [3, 2], [4, 1]], [[0, 3], [1, 2], [2, 3], [3, 2], [4, 3]], [[0, 2], [1, 2], [2, 3], [3, 2], [4, 2]]], "name": "CheckWins", "label": "CheckWins", "nodeLabel": "CheckWins", "freeSpinsSymbol": 11}, "ports": [], "dynamicports": [], "children": []}, {"id": "9c24bdc0-06bf-2c1e-93ae-ef1b642a596c", "type": "Get Paytable", "label": "GetPaytable", "x": 120, "y": 240, "parameters": {"numberOfSymbols": 10, "name": "GetPaytable", "label": "GetPaytable", "nodeLabel": "GetPaytable", "symbolPayout1": 4.53, "symbolPayout2": 5.66, "symbolPayout3": 6.8, "symbolPayout4": 7.93, "symbolPayout5": 9.06, "symbolPayout6": 10.19, "symbolPayout7": 11.33, "symbolPayout8": 12.46, "symbolPayout9": 13.59, "symbolPayout10": 14.72}, "ports": [], "dynamicports": [{"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout1", "displayName": "Symbol 1 Custom Payout", "default": 3, "index": 8}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout2", "displayName": "Symbol 2 Custom Payout", "default": 3.75, "index": 9}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout3", "displayName": "Symbol 3 Custom Payout", "default": 4.5, "index": 10}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout4", "displayName": "Symbol 4 Custom Payout", "default": 5.25, "index": 11}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout5", "displayName": "Symbol 5 Custom Payout", "default": 6, "index": 12}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout6", "displayName": "Symbol 6 Custom Payout", "default": 6.75, "index": 13}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout7", "displayName": "Symbol 7 Custom Payout", "default": 7.5, "index": 14}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout8", "displayName": "Symbol 8 Custom Payout", "default": 8.25, "index": 15}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout9", "displayName": "Symbol 9 Custom Payout", "default": 9, "index": 16}, {"type": "number", "plug": "input", "group": "Custom Payouts", "name": "symbolPayout10", "displayName": "Symbol 10 Custom Payout", "default": 9.75, "index": 17}], "children": []}, {"id": "2a87de12-f5b3-ff1d-f707-b1d77371b0e1", "type": "Calculate Winnings", "label": "CalcWin", "x": 120, "y": 240, "parameters": {"name": "CalcWin", "label": "CalcWin", "nodeLabel": "CalcWin"}, "ports": [], "dynamicports": [], "children": []}, {"id": "3d882bc1-0c39-5f5c-feea-cc97d6506e40", "type": "JavaScriptFunction", "label": "RP_PassLoop", "x": 1300, "y": 0, "parameters": {"functionScript": "// RP_PassLoop \u2014 scores one spin's tumbles before the round is shown. Built by scaffold({action:\"round_player\", cascade: true}).\n//\n// Pass 1 scores the spin's board. While a pass wins, its winning cells are removed and refilled\n// (@RP_PassCascade, fresh @RP_PassTRNG \u2192 @RP_PassISAAC seeds every pass) and the new board is scored\n// again, until a pass wins nothing or MAX_PASSES is reached. The round's win is the SUM of the\n// passes: Total goes where the first pass's win used to go, so the maths pays (and takes the bet)\n// once per spin, as before. Book lists every pass {grid, win, winningCells} for the round player.\n//\n// run fires three ways: the spin's board is ready (a new board), a pass was scored, a refill is ready.\nconst MAX_PASSES = 12;\nconst s = this;\nif (Inputs.SpinBoard !== s._spinBoard) {            // a new spin: score its board (pass 1)\n  s._spinBoard = Inputs.SpinBoard;\n  s._grid = Inputs.SpinBoard;\n  s._passes = [];\n  s._total = 0;\n  s._phase = 'score';\n  Outputs.Grid = s._grid;\n  Outputs.Score();\n  return;\n}\nif (s._phase === 'refill') {                         // the refill is ready: score the new board\n  if (!Array.isArray(Inputs.Refilled) || Inputs.Refilled === s._grid) return;\n  s._grid = Inputs.Refilled;\n  s._phase = 'score';\n  Outputs.Grid = s._grid;\n  Outputs.Score();\n  return;\n}\nif (s._phase !== 'score') return;\nconst win = Number(Inputs.Win) || 0;                // a pass was scored\ns._total += win;\ns._passes.push({ grid: s._grid, win: win, winningCells: Array.isArray(Inputs.Cells) ? Inputs.Cells : [] });\nif (win > 0 && s._passes.length < MAX_PASSES) {\n  s._phase = 'refill';\n  Outputs.Refill();                                  // remove this pass's winning cells and refill them\n  return;\n}\ns._phase = 'settled';\nOutputs.Total = s._total;\nOutputs.Book = { passes: s._passes.slice(), total: s._total };\nOutputs.Settle();                                    // the maths settles the round once, on the total\n", "nodeLabel": "RP_PassLoop"}, "ports": [], "dynamicports": [{"name": "in-SpinBoard", "displayName": "SpinBoard", "plug": "input", "type": "*", "group": "Inputs", "index": 4}, {"name": "in-Refilled", "displayName": "Refilled", "plug": "input", "type": "*", "group": "Inputs", "index": 5}, {"name": "in-Win", "displayName": "Win", "plug": "input", "type": "*", "group": "Inputs", "index": 6}, {"name": "in-Cells", "displayName": "Cells", "plug": "input", "type": "*", "group": "Inputs", "index": 7}, {"name": "out-Score", "displayName": "Score", "plug": "output", "type": "signal", "group": "Outputs", "index": 8}, {"name": "out-Refill", "displayName": "Refill", "plug": "output", "type": "signal", "group": "Outputs", "index": 9}, {"name": "out-Settle", "displayName": "Settle", "plug": "output", "type": "signal", "group": "Outputs", "index": 10}, {"name": "out-Grid", "displayName": "Grid", "plug": "output", "type": "*", "group": "Outputs", "index": 11}, {"name": "out-Total", "displayName": "Total", "plug": "output", "type": "*", "group": "Outputs", "index": 12}, {"name": "out-Book", "displayName": "Book", "plug": "output", "type": "*", "group": "Outputs", "index": 13}], "children": [], "metadata": {"merge": {"soureCodePorts": ["functionScript"]}}}, {"id": "f69efad8-c38c-6215-00a1-d82adfb43e59", "type": "True Random Number Generator", "label": "RP_PassTRNG", "x": 1660, "y": 0, "parameters": {"nodeLabel": "RP_PassTRNG"}, "ports": [], "dynamicports": [], "children": []}, {"id": "f2442c27-3d94-91bf-ab5a-822ab27fa1eb", "type": "ISAAC Random Number Array Generator", "label": "RP_PassISAAC", "x": 1660, "y": 140, "parameters": {"nodeLabel": "RP_PassISAAC"}, "ports": [], "dynamicports": [], "children": []}, {"id": "978ac546-ea14-e859-17dd-8cf2aa51d24e", "type": "Cascade The Reels", "label": "RP_PassCascade", "x": 1660, "y": 280, "parameters": {"nodeLabel": "RP_PassCascade"}, "ports": [], "dynamicports": [], "children": []}, {"id": "6dac9a76-ba01-e0f2-ee80-43542f38bab9", "type": "JavaScriptFunction", "label": "ScatterCheck", "x": 540, "y": 480, "parameters": {"functionScript": "// Scatter check: count pot-of-gold symbols (id 9, 1-based like the paytable) on the FINAL board.\n// No RNG \u2014 pure counting on the maths' own grid.\nconst g = Inputs.Grid;\nlet count = 0;\nconst flat = [];\nconst walk = function (x) { if (Array.isArray(x)) { x.forEach(walk); } else { flat.push(Number(x)); } };\nwalk(g);\nfor (let i = 0; i < flat.length; i++) { if (flat[i] === 9) count++; }\nOutputs.Triggered = count >= 3;\nOutputs.Count = count;\nOutputs.Done();", "name": "ScatterCheck", "label": "ScatterCheck", "nodeLabel": "ScatterCheck"}, "ports": [], "dynamicports": [{"name": "in-Grid", "displayName": "Grid", "plug": "input", "type": "*", "group": "Inputs", "index": 4}, {"name": "out-Done", "displayName": "Done", "plug": "output", "type": "signal", "group": "Outputs", "index": 5}, {"name": "out-Triggered", "displayName": "Triggered", "plug": "output", "type": "*", "group": "Outputs", "index": 6}, {"name": "out-Count", "displayName": "Count", "plug": "output", "type": "*", "group": "Outputs", "index": 7}], "children": [], "metadata": {"merge": {"soureCodePorts": ["functionScript"]}}}, {"id": "421e8f4f-03c1-0540-e1d1-b387226088a4", "type": "Condition", "label": "BonusGate", "x": 1860, "y": 0, "parameters": {"name": "BonusGate", "label": "BonusGate", "nodeLabel": "BonusGate"}, "ports": [], "dynamicports": [], "children": []}, {"id": "3513c47a-998f-ad85-3ba6-9442c0100f07", "type": "True Random Number Generator", "label": "TRNG_Bonus", "x": 1860, "y": 0, "parameters": {"name": "TRNG_Bonus", "label": "TRNG_Bonus", "nodeLabel": "TRNG_Bonus"}, "ports": [], "dynamicports": [], "children": []}, {"id": "412ed2ef-ce2e-2445-f255-bcdb26926475", "type": "ISAAC Random Number Array Generator", "label": "ISAAC_Bonus", "x": 1860, "y": 0, "parameters": {"size": 12, "nonce": 777, "name": "ISAAC_Bonus", "label": "ISAAC_Bonus", "nodeLabel": "ISAAC_Bonus"}, "ports": [], "dynamicports": [], "children": []}, {"id": "fdeca17d-5828-fabb-094e-38d69f0c5c72", "type": "JavaScriptFunction", "label": "BonusPrizes", "x": 540, "y": 480, "parameters": {"functionScript": "// Deal 12 pot prizes as multipliers of bet, drawn WITHOUT replacement from a weighted pool.\n// Randomness comes ONLY from the ISAAC stream (integers in 0..1e12 \u2014 normalise by dividing).\n// Pool tuned against measured RTP: mean \u2248 0.56\u00d7 per prize, \u2248 2.8\u00d7 per bonus at ~6% trigger.\nconst POOL = [\n  { v: 0.2, w: 20 }, { v: 0.2, w: 20 },\n  { v: 0.3, w: 16 }, { v: 0.3, w: 16 },\n  { v: 0.5, w: 12 }, { v: 0.5, w: 12 },\n  { v: 0.8, w: 8 },  { v: 0.8, w: 8 },\n  { v: 1,   w: 5 },  { v: 1,   w: 5 },\n  { v: 2,   w: 3 },\n  { v: 5,   w: 1.5 },\n  { v: 10,  w: 0.5 }\n];\nlet totalW = 0;\nfor (let i = 0; i < POOL.length; i++) totalW += POOL[i].w;\n\nconst seeds = Inputs.Seeds;\nconst bet = Number(Inputs.BetAmount);\nif (!Array.isArray(seeds) || seeds.length < 12 || !(bet > 0)) {\n  // No stream or no real bet: clear the handshake AND the stale prizes so the popup can\n  // never open on a previous round's data, and deal nothing (Done stays unfired).\n  globalThis.__pickapot = null;\n  Outputs.Prizes = null;\n  return;\n}\n\nconst available = POOL.map(function (p) { return { v: p.v, w: p.w }; });\nlet wLeft = totalW;\nconst prizes = [];\nfor (let k = 0; k < 12; k++) {\n  const u = (Number(seeds[k]) || 0) / 1e12;\n  let target = u * wLeft;\n  let picked = available.length - 1;\n  let acc = 0;\n  for (let i = 0; i < available.length; i++) {\n    acc += available[i].w;\n    if (target <= acc) { picked = i; break; }\n  }\n  prizes.push(available[picked].v);\n  wLeft -= available[picked].w;\n  available.splice(picked, 1);\n}\nOutputs.Prizes = prizes;\n// Hand the dealt prizes + bet to the bonus popup through the documented globalThis handshake\n// (BonusCtrl reads globalThis.__pickapot when the popup opens). Inputs.BetAmount is wired\n// from this component's Component Inputs.BetAmount, which /App feeds from @BetVar.\nglobalThis.__pickapot = { prizes: prizes, bet: bet };\nOutputs.Done();", "name": "BonusPrizes", "label": "BonusPrizes", "nodeLabel": "BonusPrizes"}, "ports": [], "dynamicports": [{"name": "in-Seeds", "displayName": "Seeds", "plug": "input", "type": "*", "group": "Inputs", "index": 4}, {"name"