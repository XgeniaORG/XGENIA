{
    "name": "huggingface-mcp-server",
    "version": "0.1.0",
    "description": "A Model Context Protocol server for Hugging Face Inference",
    "license": "MIT",
    "type": "module",
    "bin": {
        "huggingface-mcp-server": "build/index.js"
    },
    "files": [
        "build"
    ],
    "scripts": {
        "build": "npx tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
        "start": "node build/index.js",
        "dev": "npx tsc --watch & node src/index.js",
        "watch": "npx tsc --watch",
        "inspector": "npx @modelcontextprotocol/inspector build/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.1",
        "@huggingface/inference": "^2.6.4",
        "dotenv": "^16.4.5",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.11.24",
        "typescript": "^5.3.3"
    }
}