# Google Vertex AI MCP Server Configuration
# Copy this file to .env and fill in your values

# Choose your AI provider: "vertex" (recommended) or "gemini"
AI_PROVIDER=vertex

# === Vertex AI Configuration (Recommended) ===
# Your Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id-here

# Google Cloud region (us-central1, us-east1, europe-west1, etc.)
GOOGLE_CLOUD_LOCATION=us-central1

# Path to your service account key file (if using service accounts)
# GOOGLE_APPLICATION_CREDENTIALS=./key.json

# === Gemini API Configuration (Alternative) ===
# Your Gemini API key (if using AI_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key-here

# === AI Model Configuration ===
# Model ID for Vertex AI
VERTEX_MODEL_ID=gemini-2.0-flash-exp

# Model ID for Gemini API
GEMINI_MODEL_ID=gemini-2.0-flash-exp

# === Generation Parameters ===
# Temperature: 0.0 (focused) to 2.0 (creative)
AI_TEMPERATURE=0.7

# Maximum output tokens
AI_MAX_OUTPUT_TOKENS=8192

# Enable streaming for long generations
AI_USE_STREAMING=true

# === Retry Configuration ===
# Maximum retry attempts
AI_MAX_RETRIES=3

# Delay between retries (milliseconds)
AI_RETRY_DELAY_MS=1000

# === Example Values (Replace with your actual values) ===
# AI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=my-awesome-project-123
# GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_MODEL_ID=gemini-2.0-flash-exp
# AI_TEMPERATURE=0.7

