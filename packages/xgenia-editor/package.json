{
  "name": "xgenia-editor",
  "productName": "XGENIA",
  "description": "Node-Based App Builder for Scalability & Rapid Development, a fork of XGENIA",
  "author": "XGENIA <contact@xgenia.ai>",
  "homepage": "https://xgenia.ai",
  "version": "2.1.1",
  "main": "src/main/main.bundle.js",
  "scripts": {
    "build": "npm run build:node-docs && npx ts-node -P ./tsconfig.build.json ./scripts/build.ts",
    "build:node-docs": "node scripts/compile-node-source-docs.js",
    "watch:node-docs": "nodemon --watch ../xgenia-runtime/src/nodes --exec npm run build:node-docs",
    "build:renderer:dev": "npx webpack --config=webpackconfigs/webpack.renderer.production.js --mode=development && cp dist/bundles/src/editor/index.bundle.js src/editor/",
    "clean-bundles": "rm -f src/main/main.bundle.js src/editor/index.bundle.js",
    "rebuild-bundles": "npm run clean-bundles && npm run build:renderer:dev",
    "start": "webpack-dev-server --config=webpackconfigs/webpack.renderer.dev.js",
    "start:_dev": "electron dev-main.js --dev",
    "start:_dev_webpack": "electron . --dev",
    "dev": "npx ts-node scripts/dev.ts",
    "test": "webpack-dev-server --config=webpackconfigs/webpack.test.js",
    "test:_start_electron": "electron test.js",
    "test:ci": "webpack-cli --config=webpackconfigs/webpack.test-ci.js && electron test.js",
    "install-node22": "npm install --engine-strict=false",
    "switch-component": "npx ts-node scripts/switch-component.ts",
    "ai-service": "cd ../xgenia-ai-service && npm run dev",
    "ai-service:install": "cd ../xgenia-ai-service && npm install"
  },
  "build": {
    "appId": "com.xgenia.nb",
    "afterSign": "./build/macos-notarize.js",
    "publish": {
      "provider": "github",
      "owner": "XgeniaORG",
      "repo": "XGENIA"
    },
    "mac": {
      "icon": "./build/icons/1024x1024.png",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-mac.${ext}",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "./build/entitlements.mac.plist",
      "extendInfo": {
        "LSMultipleInstancesProhibited": true,
        "NSMicrophoneUsageDescription": "Allow XGENIA apps that you create and run to access the microphone?",
        "NSCameraUsageDescription": "Allow XGENIA apps that you create and run to access the camera?"
      }
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "guid": "XGENIA.net.XGENIA",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "deb",
      "icon": "build/icons",
      "category": "Development"
    },
    "protocols": {
      "name": "xgenia",
      "schemes": [
        "xgenia"
      ]
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/dugite/**",
      "node_modules/desktop-trampoline/**"
    ],
    "files": [
      "dist/**/*",
      "*.js",
      "src",
      "node_modules",
      "!node_modules/monaco-editor",
      "node_modules/monaco-editor/esm",
      "node_modules/dugite",
      "!test.js",
      "!src/main/main.js",
      "!src/main/src",
      "!src/editor/src/**/*",
      "src/editor/src/styles/custom-properties/app-colors.css",
      "!src/frames/viewer-frame/src",
      "!src/shared"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.16.7",
    "@electron/remote": "^2.1.2",
